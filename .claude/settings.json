{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-broad-git-add.js\"",
            "timeout": 10,
            "statusMessage": "Scope-Schutz: git-Kommando prüfen"
          }
        ]
      }
    ]
  }
}
